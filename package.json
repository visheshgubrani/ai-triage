{
  "name": "ai-triage",
  "version": "0.7.0",
  "description": "Self-hosted AI inbox for business email and documents: an LLM classifies and extracts fields with quoted evidence, checks decide what's safe to automate, and people review the rest.",
  "keywords": [
    "ai",
    "llm",
    "document-processing",
    "intelligent-document-processing",
    "data-extraction",
    "email-automation",
    "email-triage",
    "triage",
    "human-in-the-loop",
    "invoice-processing",
    "llm-evaluation",
    "evals",
    "structured-output",
    "json-schema",
    "claude",
    "openai",
    "ocr",
    "webhooks",
    "self-hosted",
    "multi-tenant"
  ],
  "homepage": "https://github.com/visheshgubrani/ai-triage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visheshgubrani/ai-triage.git"
  },
  "bugs": {
    "url": "https://github.com/visheshgubrani/ai-triage/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "config:docs": "pnpm --filter @ai-triage/db config:docs",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:reset": "node scripts/dev-setup.mjs --reset",
    "preflight": "pnpm --silent --filter @ai-triage/worker preflight",
    "infra:up": "docker compose up -d --wait postgres storage webhook-catcher && docker compose run --rm storage-init",
    "infra:down": "docker compose down",
    "db:generate": "pnpm --filter @ai-triage/db generate",
    "db:migrate": "pnpm --filter @ai-triage/db migrate",
    "db:seed": "pnpm --filter @ai-triage/db seed && pnpm --filter @ai-triage/worker seed:documents && pnpm --filter @ai-triage/worker seed:evals",
    "api-key:create": "pnpm --filter @ai-triage/db api-key:create",
    "secrets:rotate-key": "pnpm --filter @ai-triage/db secrets:rotate-key",
    "tenant:create": "pnpm --filter @ai-triage/db tenant:create",
    "setup-link": "pnpm --filter @ai-triage/db setup-link",
    "tenant:delete": "pnpm --filter @ai-triage/worker tenant:delete",
    "ingest": "pnpm --filter @ai-triage/api ingest",
    "fake-google": "pnpm --filter @ai-triage/mailbox fake-google",
    "llm-sim": "pnpm --filter @ai-triage/llm llm-sim",
    "load": "pnpm --filter @ai-triage/worker load",
    "fixtures:generate": "pnpm --filter @ai-triage/fixtures generate",
    "cassettes:record": "pnpm --filter @ai-triage/worker cassettes:record",
    "eval:import": "pnpm --filter @ai-triage/worker eval:import",
    "e2e": "playwright test",
    "demo:record": "tsx scripts/demo/record.ts",
    "demo:render": "tsx scripts/demo/render.ts",
    "demo:video": "pnpm demo:record && pnpm demo:render"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "license": "MIT"
}
