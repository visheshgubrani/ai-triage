# Never bake local secrets or build output into the image; compose passes the environment.
.env
.env.*
!.env.example
.git
.github
.claude
**/node_modules
**/.next
**/dist
**/.turbo
**/*.tsbuildinfo
test-results
playwright-report
# Not needed to build: screenshots, the e2e specs, deploy files.
docs/media
e2e
deploy
