# Copy to .env (cp .env.example .env). Ports avoid common local defaults.
# Generated from packages/core/src/env.ts by `pnpm config:docs`; edit there, not here.
# Every variable is described in docs/configuration.md.

# ── Instance ──
# Local demo / development. With NODE_ENV=production the api and worker refuse the dev defaults
# below unless this is set (docs/security.md, production checklist). Never set it on a real
# instance.
TRIAGE_DEMO=true
# `production` turns on the startup safety checks. The Docker image sets it; leave it unset for
# development.
# NODE_ENV=

# ── Postgres ──
# Host port of the compose Postgres.
POSTGRES_PORT=5440
# The owner role: migrations, seeds and the admin CLIs only. Never give it to the api, worker or
# web.
DATABASE_OWNER_URL=postgres://triage:triage@localhost:5440/triage
# The app role, created by `pnpm db:migrate` and subject to row-level security. The worker needs a
# direct (non-pooled) connection: pg-boss uses LISTEN and advisory locks.
DATABASE_URL=postgres://triage_app:triage_app@localhost:5440/triage

# ── Storage ──
# Host port of the compose RustFS (S3 API).
S3_PORT=9020
# Host port of the RustFS console.
S3_CONSOLE_PORT=9021
# S3-compatible endpoint the server uses (AWS: https://s3.<region>.amazonaws.com).
S3_ENDPOINT=http://localhost:9020
# Region used for request signing.
S3_REGION=us-east-1
# Bucket for document sources. Keep it private; files are served through short-lived presigned URLs.
S3_BUCKET=triage
# Storage access key.
S3_ACCESS_KEY_ID=triage
# Storage secret key. Production refuses the dev default.
S3_SECRET_ACCESS_KEY=triage-secret
# Host used in presigned URLs, which the browser must reach (differs from S3_ENDPOINT inside
# docker). Keep it on its own origin: user files never share the app's origin.
S3_PUBLIC_ENDPOINT=http://localhost:9020

# ── Limits ──
# Largest accepted file. Inline PDFs are base64-encoded (4/3 larger) and a request may not exceed 32
# MB.
MAX_FILE_MB=20
# PDFs with more pages fail as too_many_pages.
MAX_PDF_PAGES=100

# ── Postmark inbound ──
# Basic-auth user in the Postmark inbound webhook URL (https://user:pass@host/webhooks/postmark).
# Unset with the password: the webhook is off.
POSTMARK_INBOUND_USER=postmark
# Basic-auth password for the Postmark webhook. Production needs 16 or more characters.
POSTMARK_INBOUND_PASSWORD=dev-only-postmark-password
# Domain of generated (unguessable) inbound addresses. Empty: new tenants get no address, and
# existing ones keep their domain.
INBOUND_DOMAIN=

# ── API and web ──
# Port the api listens on.
API_PORT=8787
# Host port of the web app in the Docker demo.
# WEB_PORT=
# Origin of the web app: CORS, the Origin check, invite links, OAuth redirects back to the UI.
WEB_ORIGIN=http://localhost:3000
# How the web server reaches the api (in compose: http://api:8787). The browser never uses it.
# API_INTERNAL_URL=
# The api as the browser sees it. Inlined into the web bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:8787
# Proxies in front of the API (IPs or CIDRs, comma-separated): only their X-Forwarded-For is
# believed, for rate limits, audit and session IPs. Empty: the socket address is the client.
TRUSTED_PROXIES=
# Multiplies every request limit (apps/api/src/rate-limit.ts), for a busy instance.
RATE_LIMIT_SCALE=1
# Admin-only routes need the admin's TOTP 2FA. Defaults to on, except with TRIAGE_DEMO=true.
REQUIRE_ADMIN_2FA=

# ── Secrets ──
# Encrypts webhook signing secrets and mailbox tokens at rest: 32 random bytes, base64 (`openssl
# rand -base64 32`). Unset in development and the demo, a published dev key is used; production
# refuses to start without one.
ENCRYPTION_KEY=
# A key ring for rotation, newest first: `new:<base64>,old:<base64>`. Then run `pnpm
# secrets:rotate-key`. Takes precedence over ENCRYPTION_KEY.
# ENCRYPTION_KEYS=
# Signs sessions. Dev-only value here; generate a real one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# Public base URL of the api, for auth callbacks. Must be https in production.
BETTER_AUTH_URL=http://localhost:8787

# ── Google ──
# One OAuth client for Sign in with Google and Gmail mailbox sync (docs/google.md). Leave it and the
# secret empty to hide every Google feature. Redirect URIs to register:
# <BETTER_AUTH_URL>/api/auth/callback/google and <BETTER_AUTH_URL>/integrations/google/callback.
GOOGLE_CLIENT_ID=
# The OAuth client's secret. Set both or neither.
GOOGLE_CLIENT_SECRET=
# Points Google's consent screen at the local fake (`pnpm fake-google`, e.g. http://localhost:9040)
# for the demo and e2e. Production refuses it unless TRIAGE_DEMO=true.
# GOOGLE_OAUTH_URL=
# The fake's token endpoint as the server reaches it, when that differs from the browser's address.
# GOOGLE_TOKEN_URL=
# Points the Gmail API at the local fake. Production refuses it unless TRIAGE_DEMO=true.
# GOOGLE_API_URL=
# Port of `pnpm fake-google`.
# FAKE_GOOGLE_PORT=
# The address the fake Google's demo mailbox answers as.
# FAKE_GOOGLE_MAILBOX=

# ── Models ──
# replay (default: recorded responses, no key, no spend) | record (live calls, saved as cassettes) |
# live.
LLM_MODE=replay
# Needed only in record/live mode, and only when a config uses Claude.
ANTHROPIC_API_KEY=
# For `openai:` models.
OPENAI_API_KEY=
# Overrides the OpenAI endpoint (a proxy or gateway).
# OPENAI_BASE_URL=
# For `deepseek:` models.
DEEPSEEK_API_KEY=
# Overrides the DeepSeek endpoint.
# DEEPSEEK_BASE_URL=
# For `openrouter:` models.
OPENROUTER_API_KEY=
# Overrides the OpenRouter endpoint.
# OPENROUTER_BASE_URL=
# Any OpenAI-compatible server for `compat:` models, e.g. Ollama at http://localhost:11434/v1.
OPENAI_COMPAT_BASE_URL=
# Key for the compat server, if it needs one.
OPENAI_COMPAT_API_KEY=
# Recorded responses (replay reads, record writes). Relative to the repo root.
CASSETTE_DIR=fixtures/cassettes
# The synthetic documents used by the seeds and the recorder.
FIXTURES_DIR=fixtures

# ── Worker ──
# Concurrent jobs per LLM stage queue (classify and extract each), per worker process.
WORKER_LLM_CONCURRENCY=4
# Eval items processed at once (each makes up to two model calls), on top of the pipeline stages.
WORKER_EVAL_CONCURRENCY=2
# Gmail messages downloaded at once.
WORKER_MAILBOX_CONCURRENCY=4
# New messages one sync of a mailbox takes; the rest follow a minute later.
MAILBOX_SYNC_BATCH=200

# ── Webhooks ──
# URLs must be public https hosts (SSRF guard). Receivers on a private network go here as hostnames
# or CIDRs (these may also use http). TRIAGE_DEMO adds localhost and the catcher.
WEBHOOK_ALLOWED_HOSTS=
# How long a delivery waits for the receiver.
WEBHOOK_TIMEOUT_MS=10000
# Host port of the local webhook catcher (docker compose).
CATCHER_PORT=9030
# The demo tenant's webhook, which the seed points at the catcher.
DEMO_WEBHOOK_URL=http://localhost:9030/hooks/demo
# The demo tenant's signing secret (the catcher verifies with it).
DEMO_WEBHOOK_SECRET=whsec_dev_only_demo_webhook_secret

# ── CLI ──
# `pnpm ingest <file>`: the API base URL.
TRIAGE_API_URL=http://localhost:8787
# `pnpm ingest <file>`: a tenant API key (create one with `pnpm api-key:create --tenant demo`).
TRIAGE_API_KEY=

# ── End-to-end tests ──
# `pnpm e2e`: the running web app.
# WEB_URL=
# `pnpm e2e`: the running api.
# API_URL=
# `pnpm e2e`: the webhook catcher.
# CATCHER_URL=
# `pnpm e2e`: the fake Google (`pnpm fake-google`).
# FAKE_GOOGLE_URL=
# `pnpm e2e`: record videos of the walkthroughs (the README GIFs).
# WALKTHROUGH_VIDEO=
