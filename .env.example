# Copy to .env (cp .env.example .env). Ports avoid common local defaults.

# Postgres (docker compose). Two roles: the owner (compose superuser) runs migrations
# and seeds; the app role is created by `pnpm db:migrate` and is subject to RLS.
POSTGRES_PORT=5440
DATABASE_OWNER_URL=postgres://triage:triage@localhost:5440/triage
DATABASE_URL=postgres://triage_app:triage_app@localhost:5440/triage

# S3-compatible storage (RustFS in docker compose; console on S3_CONSOLE_PORT)
S3_PORT=9020
S3_CONSOLE_PORT=9021
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=triage
S3_ACCESS_KEY_ID=triage
S3_SECRET_ACCESS_KEY=triage-secret
# Host used in presigned URLs, which the browser must reach (differs from S3_ENDPOINT inside docker).
S3_PUBLIC_ENDPOINT=http://localhost:9020

# App limits. Inline PDFs are base64-encoded (4/3 larger) and a request may not exceed 32 MB.
MAX_FILE_MB=20
MAX_PDF_PAGES=100

# Postmark inbound webhook: put these credentials in the webhook URL (https://user:pass@host/webhooks/postmark).
POSTMARK_INBOUND_USER=postmark
POSTMARK_INBOUND_PASSWORD=dev-only-postmark-password

# API
API_PORT=8787
WEB_ORIGIN=http://localhost:3000

# Better Auth (dev-only secret; generate a real one with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:8787

# Web
NEXT_PUBLIC_API_URL=http://localhost:8787

# LLM: replay (default, no key, no spend) | record | live
LLM_MODE=replay
# Provider keys, needed only in record/live mode and only for providers your config uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible server for `compat:` models, e.g. Ollama at http://localhost:11434/v1 (key optional).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Recorded responses (replay reads, record writes) and the synthetic documents. Relative to the repo root.
CASSETTE_DIR=fixtures/cassettes
FIXTURES_DIR=fixtures

# Worker: concurrent jobs per LLM stage queue.
WORKER_LLM_CONCURRENCY=4

# Webhook delivery. Tenants must use https: unless WEBHOOK_ALLOW_HTTP=true (local development only).
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_TIMEOUT_MS=10000
# Local webhook catcher (docker compose), and the demo tenant's webhook, which the seed points at it.
CATCHER_PORT=9030
DEMO_WEBHOOK_URL=http://localhost:9030/hooks/demo
DEMO_WEBHOOK_SECRET=whsec_dev_only_demo_webhook_secret

# `pnpm ingest <file>`: API base URL and a tenant API key (create one with `pnpm api-key:create --tenant demo`).
TRIAGE_API_URL=http://localhost:8787
TRIAGE_API_KEY=
