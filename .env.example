# Copy to .env (cp .env.example .env). Ports avoid common local defaults.
# Generated from packages/core/src/env.ts by `pnpm config:docs`; edit there, not here.
# Every variable is described in docs/configuration.md.

# ── Instance ──
# Local demo / development. With NODE_ENV=production the api and worker refuse the dev defaults
# below unless this is set (docs/security.md, production checklist). Never set it on a real
# instance.
TRIAGE_DEMO=true
# `production` turns on the startup safety checks. The Docker image sets it; leave it unset for
# development.
# NODE_ENV=

# ── Postgres ──
# Host port of the compose Postgres.
POSTGRES_PORT=5440
# The owner role: migrations, seeds and the admin CLIs only. Never give it to the api, worker or
# web.
DATABASE_OWNER_URL=postgres://triage:triage@localhost:5440/triage
# Where `db:migrate` finds the SQL migrations. The Docker image sets it for its bundled CLI.
# MIGRATIONS_DIR=
# The app role, created by `pnpm db:migrate` and subject to row-level security. The worker needs a
# direct (non-pooled) connection: pg-boss uses LISTEN and advisory locks.
DATABASE_URL=postgres://triage_app:triage_app@localhost:5440/triage
# Connections in the app's pool, per process (pg-boss keeps 10 more of its own). Raise it with the
# worker's concurrency; keep the total under Postgres's max_connections.
# DB_POOL_MAX=

# ── Storage ──
# Host port of the compose RustFS (S3 API).
S3_PORT=9020
# Host port of the RustFS console.
S3_CONSOLE_PORT=9021
# S3-compatible endpoint the server uses (AWS: https://s3.<region>.amazonaws.com).
S3_ENDPOINT=http://localhost:9020
# Region used for request signing.
S3_REGION=us-east-1
# Bucket for document sources. Keep it private; files are served through short-lived presigned URLs.
S3_BUCKET=triage
# Storage access key.
S3_ACCESS_KEY_ID=triage
# Storage secret key. Production refuses the dev default.
S3_SECRET_ACCESS_KEY=triage-secret
# Host used in presigned URLs, which the browser must reach (differs from S3_ENDPOINT inside
# docker). Keep it on its own origin: user files never share the app's origin.
S3_PUBLIC_ENDPOINT=http://localhost:9020

# ── Limits ──
# Largest accepted file. Inline PDFs are base64-encoded (4/3 larger) and a request may not exceed 32
# MB.
MAX_FILE_MB=20
# PDFs with more pages fail as too_many_pages.
MAX_PDF_PAGES=100

# ── Postmark inbound ──
# Basic-auth user in the Postmark inbound webhook URL
# (https://user:pass@host/api/webhooks/postmark). Unset with the password: the webhook is off.
POSTMARK_INBOUND_USER=postmark
# Basic-auth password for the Postmark webhook. Production needs 16 or more characters.
POSTMARK_INBOUND_PASSWORD=dev-only-postmark-password
# Where generated (unguessable) inbound addresses live: a domain whose MX points at Postmark
# (`inbound.acme.com`), or a Postmark server's own inbound address
# (`abc123@inbound.postmarkapp.com`), which needs no DNS: tenants then get
# `abc123+t-…@inbound.postmarkapp.com`. Empty: new tenants get no address, and existing ones keep
# theirs.
INBOUND_DOMAIN=

# ── API and web ──
# Port the api listens on.
API_PORT=8787
# Host port of the web app in the Docker demo.
# WEB_PORT=
# The one address people use: the web app, with the API under /api on the same origin (cookies, the
# Origin check, invite links, OAuth redirect URIs). An origin only, no path. Must be https in
# production.
PUBLIC_URL=http://localhost:3000
# Older name for PUBLIC_URL, still honored when PUBLIC_URL is unset.
# WEB_ORIGIN=
# How the web server reaches the api, without /api (in compose: http://api:8787). Server components
# call it directly; `pnpm dev` also proxies the browser's /api through it.
# API_INTERNAL_URL=
# Turns on /api/metrics (Prometheus) for scrapers sending `Authorization: Bearer <token>`. Unset:
# the endpoint answers 404.
# METRICS_TOKEN=
# No longer used (the browser calls /api on the same origin). The api warns when it's set.
# NEXT_PUBLIC_API_URL=
# Proxies in front of the API (IPs or CIDRs, comma-separated): only their X-Forwarded-For is
# believed, for rate limits, audit and session IPs. Empty: the socket address is the client.
TRUSTED_PROXIES=
# Multiplies every request limit (apps/api/src/rate-limit.ts), for a busy instance.
RATE_LIMIT_SCALE=1
# Admin-only routes need the admin's TOTP 2FA. Defaults to on, except with TRIAGE_DEMO=true.
REQUIRE_ADMIN_2FA=

# ── Secrets ──
# Encrypts webhook signing secrets and mailbox tokens at rest: 32 random bytes, base64 (`openssl
# rand -base64 32`). Unset in development and the demo, a published dev key is used; production
# refuses to start without one.
ENCRYPTION_KEY=
# A key ring for rotation, newest first: `new:<base64>,old:<base64>`. Then run `pnpm
# secrets:rotate-key`. Takes precedence over ENCRYPTION_KEY.
# ENCRYPTION_KEYS=
# Signs sessions. Dev-only value here; generate a real one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
# No longer needed: auth runs at PUBLIC_URL/api/auth. A value on another origin is ignored with a
# warning.
# BETTER_AUTH_URL=

# ── Google ──
# One OAuth client for Sign in with Google and Gmail mailbox sync (docs/google.md). Leave it and the
# secret empty to hide every Google feature. Redirect URIs to register:
# <PUBLIC_URL>/api/auth/callback/google and <PUBLIC_URL>/api/integrations/google/callback.
GOOGLE_CLIENT_ID=
# The OAuth client's secret. Set both or neither.
GOOGLE_CLIENT_SECRET=
# Points Google's consent screen at the local fake (`pnpm fake-google`, e.g. http://localhost:9040)
# for the demo and e2e. Production refuses it unless TRIAGE_DEMO=true.
# GOOGLE_OAUTH_URL=
# The fake's token endpoint as the server reaches it, when that differs from the browser's address.
# GOOGLE_TOKEN_URL=
# Points the Gmail API at the local fake. Production refuses it unless TRIAGE_DEMO=true.
# GOOGLE_API_URL=
# Port of `pnpm fake-google`, and the host port of the Docker demo's fake Google.
# FAKE_GOOGLE_PORT=
# The address the fake Google's demo mailbox answers as.
# FAKE_GOOGLE_MAILBOX=

# ── Models ──
# replay (default: recorded responses, no key, no spend) | record (live calls, saved as cassettes) |
# live.
LLM_MODE=replay
# The model (a MODEL_CATALOG ref) a new workspace's first pipeline config uses for both stages, at
# low effort where it has one. The installer sets it to match the provider key you gave. Admins
# change it later in Settings → Pipeline.
DEFAULT_MODEL=
# Needed only in record/live mode, and only when a config uses Claude.
ANTHROPIC_API_KEY=
# For `openai:` models.
OPENAI_API_KEY=
# Overrides the OpenAI endpoint (a proxy or gateway).
# OPENAI_BASE_URL=
# For `deepseek:` models.
DEEPSEEK_API_KEY=
# Overrides the DeepSeek endpoint.
# DEEPSEEK_BASE_URL=
# For `openrouter:` models.
OPENROUTER_API_KEY=
# Overrides the OpenRouter endpoint.
# OPENROUTER_BASE_URL=
# Any OpenAI-compatible server for `compat:` models, e.g. Ollama at http://localhost:11434/v1.
OPENAI_COMPAT_BASE_URL=
# Key for the compat server, if it needs one.
OPENAI_COMPAT_API_KEY=
# The simulator for `sim:` models (`pnpm llm-sim`, e.g. http://localhost:9050/v1): schema-valid fake
# answers at no cost, in any LLM_MODE. For load tests, integration tests and trying custom
# categories; never for real decisions.
# LLM_SIMULATOR_URL=
# Sent to the simulator as its API key; it ignores it.
# LLM_SIMULATOR_KEY=
# Port of `pnpm llm-sim`. Its latency and fault rates come from SIM_LATENCY_MS, SIM_JITTER_MS,
# SIM_RATE_429 and SIM_RATE_500, or POST /sim/config.
# LLM_SIM_PORT=
# Host port of the Docker demo's simulator.
# SIM_PORT=
# Recorded responses (replay reads, record writes). Relative to the repo root.
CASSETTE_DIR=fixtures/cassettes
# The synthetic documents used by the seeds and the recorder.
FIXTURES_DIR=fixtures

# ── Worker ──
# Concurrent jobs per LLM stage queue (classify and extract each), per worker process.
WORKER_LLM_CONCURRENCY=4
# Eval items processed at once (each makes up to two model calls), on top of the pipeline stages.
WORKER_EVAL_CONCURRENCY=2
# Gmail messages downloaded at once.
WORKER_MAILBOX_CONCURRENCY=4
# New messages one sync of a mailbox takes; the rest follow a minute later.
MAILBOX_SYNC_BATCH=200
# Fairness across tenants: at most this many of one tenant's jobs run at once per queue (pipeline
# stages, delivery, Gmail fetch), counted across every worker. Unset: no cap (one company). With
# several tenants, about half the cluster's slots per LLM queue (replicas × WORKER_LLM_CONCURRENCY).
# WORKER_TENANT_CONCURRENCY=
# The same cap for eval items, so one tenant's eval run can't take every eval slot.
# WORKER_TENANT_EVAL_CONCURRENCY=
# The worker's own HTTP server: /health (its heartbeat loop), /ready (database) and /metrics
# (Prometheus). Keep it off the public network.
# WORKER_HTTP_PORT=
# Logs are JSON lines (one per request, job and model call), or readable lines on a terminal.
# LOG_LEVEL=
# On SIGTERM, how long running jobs may finish before their model calls are aborted (they retry on
# another worker). Keep it under the container's stop grace period.
# WORKER_SHUTDOWN_GRACE_MS=
# Work unchanged this long is checked against the queue: a run, delivery or eval run with no job
# left is marked failed (Processing failed, Delivery failures), never silently re-run. At least 15.
# RECONCILE_STALL_MINUTES=
# Files are parsed in a sandboxed thread; one that takes longer fails as parse_timeout.
# PARSE_TIMEOUT_MS=
# Heap limit of the parse thread. A file that needs more fails as parse_timeout.
# PARSE_MAX_MEMORY_MB=

# ── OCR (optional) ──
# PaddleOCR-VL behind llama.cpp's server (OpenAI-compatible), such as http://ocr:8080/v1: scans and
# photos get text, so their quotes can be checked and text-only models can read them. `install.sh
# --ocr <backend>` sets it. Unset: off.
OCR_URL=
# Longest one page may take. A document's pages share a 10-minute budget (OCR_BUDGET_MS in core).
# OCR_TIMEOUT_MS=
# Pages of one document OCR reads at most; the rest stay unverifiable (sent to review).
# OCR_MAX_PAGES=

# ── Webhooks ──
# URLs must be public https hosts (SSRF guard). Receivers on a private network go here as hostnames
# or CIDRs (these may also use http). TRIAGE_DEMO adds localhost and the catcher.
WEBHOOK_ALLOWED_HOSTS=
# How long a delivery waits for the receiver.
WEBHOOK_TIMEOUT_MS=10000
# Host port of the local webhook catcher (docker compose).
CATCHER_PORT=9030
# The demo tenant's webhook, which the seed points at the catcher.
DEMO_WEBHOOK_URL=http://localhost:9030/hooks/demo
# The demo tenant's signing secret (the catcher verifies with it).
DEMO_WEBHOOK_SECRET=whsec_dev_only_demo_webhook_secret

# ── Install (deploy/compose.yaml) ──
# Image tag to run (`ghcr.io/visheshgubrani/ai-triage:<version>`). `./triage upgrade --version`
# changes it.
# TRIAGE_VERSION=
# Image repository, for running your own build (installs and the demo).
# TRIAGE_IMAGE=
# local (this machine), server (its own HTTPS on 80/443/8443) or upstream (behind your proxy).
# INSTALL_MODE=
# The installation's hostname: `localhost`, or the server's DNS name.
# APP_HOST=
# Behind your own reverse proxy (upstream): the hostname that serves stored files.
# FILES_HOST=
# A local install's port (`install.sh --port`); stored files are on the next one (FILES_PORT).
# APP_PORT=
# A local install's port for stored files: APP_PORT + 1.
# FILES_PORT=
# Caddy's address for the app: the hostname (HTTPS, automatic certificates), or `http://:3000`
# locally.
# APP_SITE=
# Caddy's address for stored files, a separate origin: the hostname on :8443, or `http://:3001`
# locally.
# FILES_SITE=
# Let's Encrypt account email (certificate expiry notices).
# ACME_EMAIL=
# Bundled Postgres: the owner's password (DATABASE_OWNER_URL uses it).
# POSTGRES_PASSWORD=
# Bundled Postgres: the app role's password (DATABASE_URL uses it; migrate sets it).
# DATABASE_APP_PASSWORD=
# Optional OCR service for scans and photos: nvidia | vulkan | rocm | cpu | off.
# OCR_BACKEND=

# ── CLI ──
# `pnpm ingest <file>`: where the API is (the api itself in dev, or PUBLIC_URL in Docker).
TRIAGE_API_URL=http://localhost:8787
# `pnpm ingest <file>`: a tenant API key (create one with `pnpm api-key:create --tenant demo`).
TRIAGE_API_KEY=

# ── End-to-end tests ──
# `pnpm e2e` and `pnpm demo:record`: the running web app.
# WEB_URL=
# `pnpm e2e`: the API, by default WEB_URL/api.
# API_URL=
# `pnpm e2e` and `pnpm demo:record`: the webhook catcher.
# CATCHER_URL=
# `pnpm e2e`: the fake Google (`pnpm fake-google`).
# FAKE_GOOGLE_URL=
# `pnpm e2e`: record videos of the walkthroughs (in test-results/).
# WALKTHROUGH_VIDEO=
# `pnpm e2e`: invite link of a fresh workspace on the simulator, for e2e/categories.spec.ts (skipped
# without it). Make one with `DEFAULT_MODEL=sim:simulated pnpm tenant:create`.
# E2E_INVITE_URL=
