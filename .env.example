# Copy to .env (cp .env.example .env). Ports avoid common local defaults.

# Local demo / development. With NODE_ENV=production the api and worker refuse the dev defaults
# below unless this is set (docs/security.md, production checklist). Never set it on a real instance.
TRIAGE_DEMO=true

# Postgres (docker compose). Two roles: the owner (compose superuser) runs migrations
# and seeds; the app role is created by `pnpm db:migrate` and is subject to RLS.
POSTGRES_PORT=5440
DATABASE_OWNER_URL=postgres://triage:triage@localhost:5440/triage
DATABASE_URL=postgres://triage_app:triage_app@localhost:5440/triage

# S3-compatible storage (RustFS in docker compose; console on S3_CONSOLE_PORT)
S3_PORT=9020
S3_CONSOLE_PORT=9021
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=triage
S3_ACCESS_KEY_ID=triage
S3_SECRET_ACCESS_KEY=triage-secret
# Host used in presigned URLs, which the browser must reach (differs from S3_ENDPOINT inside docker).
S3_PUBLIC_ENDPOINT=http://localhost:9020

# App limits. Inline PDFs are base64-encoded (4/3 larger) and a request may not exceed 32 MB.
MAX_FILE_MB=20
MAX_PDF_PAGES=100

# Postmark inbound webhook: put these credentials in the webhook URL (https://user:pass@host/webhooks/postmark).
POSTMARK_INBOUND_USER=postmark
POSTMARK_INBOUND_PASSWORD=dev-only-postmark-password
# Domain of generated (unguessable) inbound addresses; empty keeps the domain of the current one.
INBOUND_DOMAIN=

# API
API_PORT=8787
WEB_ORIGIN=http://localhost:3000
# Proxies in front of the API (IPs or CIDRs, comma-separated): only their X-Forwarded-For is
# believed, for rate limits, audit and session IPs. Empty: the socket address is the client.
TRUSTED_PROXIES=
# Multiplies every request limit (apps/api/src/rate-limit.ts), for a busy instance.
RATE_LIMIT_SCALE=1

# Encrypts webhook signing secrets and mailbox tokens at rest: 32 random bytes, base64 (`openssl rand -base64 32`).
# Unset in development and the demo, a published dev key is used; production refuses to start
# without one. To rotate keys: ENCRYPTION_KEYS=new:<base64>,old:<base64>, then `pnpm secrets:rotate-key`.
ENCRYPTION_KEY=

# Admin-only routes need the admin's TOTP 2FA. Defaults to on, except with TRIAGE_DEMO=true.
REQUIRE_ADMIN_2FA=

# Better Auth (dev-only secret; generate a real one with `openssl rand -base64 32`)
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:8787

# Google (docs/google.md): one OAuth client for Sign in with Google and Gmail mailbox sync. Leave
# both empty to hide every Google feature. Redirect URIs to register:
#   ${BETTER_AUTH_URL}/api/auth/callback/google  and  ${BETTER_AUTH_URL}/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Point Google at the local fake (infra/fake-google, e.g. http://localhost:9040) for the demo and
# e2e. Production refuses these unless TRIAGE_DEMO=true.
GOOGLE_OAUTH_URL=
GOOGLE_API_URL=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8787

# LLM: replay (default, no key, no spend) | record | live
LLM_MODE=replay
# Provider keys, needed only in record/live mode and only for providers your config uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# Any OpenAI-compatible server for `compat:` models, e.g. Ollama at http://localhost:11434/v1 (key optional).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# Recorded responses (replay reads, record writes) and the synthetic documents. Relative to the repo root.
CASSETTE_DIR=fixtures/cassettes
FIXTURES_DIR=fixtures

# Worker: concurrent jobs per LLM stage queue.
WORKER_LLM_CONCURRENCY=4
# Eval items processed at once (each makes up to two model calls), on top of the pipeline stages.
WORKER_EVAL_CONCURRENCY=2
# Gmail sync: messages downloaded at once, and how many new messages one sync of a mailbox takes
# (the rest follow a minute later).
WORKER_MAILBOX_CONCURRENCY=4
MAILBOX_SYNC_BATCH=200

# Webhook delivery. URLs must be public https hosts (SSRF guard). Receivers on a private network go
# here as hostnames or CIDRs (these may also use http). TRIAGE_DEMO adds localhost and the catcher.
WEBHOOK_ALLOWED_HOSTS=
WEBHOOK_TIMEOUT_MS=10000
# Local webhook catcher (docker compose), and the demo tenant's webhook, which the seed points at it.
CATCHER_PORT=9030
DEMO_WEBHOOK_URL=http://localhost:9030/hooks/demo
DEMO_WEBHOOK_SECRET=whsec_dev_only_demo_webhook_secret

# `pnpm ingest <file>`: API base URL and a tenant API key (create one with `pnpm api-key:create --tenant demo`).
TRIAGE_API_URL=http://localhost:8787
TRIAGE_API_KEY=
