{
  "name": "@ai-triage/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations, RLS, withTenantTx()",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./seed": "./src/seed/index.ts",
    "./migrate": "./src/migrate.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../.env src/bin/migrate.ts",
    "studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=../../.env src/bin/seed.ts",
    "api-key:create": "tsx --env-file-if-exists=../../.env src/bin/api-key.ts",
    "secrets:rotate-key": "tsx --env-file-if-exists=../../.env src/bin/rotate-key.ts",
    "tenant:create": "tsx --env-file-if-exists=../../.env src/bin/tenant-create.ts",
    "config:docs": "tsx src/bin/config-docs.ts"
  },
  "dependencies": {
    "@ai-triage/core": "workspace:*",
    "@ai-triage/evals": "workspace:*",
    "@ai-triage/schemas": "workspace:*",
    "@ai-triage/telemetry": "workspace:*",
    "better-auth": "1.7.15",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
