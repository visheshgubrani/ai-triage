{
  "name": "@ai-triage/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file-if-exists=../../.env src/bin/ingest.ts"
  },
  "dependencies": {
    "@ai-triage/contracts": "workspace:*",
    "@ai-triage/core": "workspace:*",
    "@ai-triage/db": "workspace:*",
    "@ai-triage/evals": "workspace:*",
    "@ai-triage/ingest": "workspace:*",
    "@ai-triage/mailbox": "workspace:*",
    "@ai-triage/schemas": "workspace:*",
    "@ai-triage/storage": "workspace:*",
    "@ai-triage/telemetry": "workspace:*",
    "@ai-triage/webhooks": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.16",
    "ipaddr.js": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  }
}
