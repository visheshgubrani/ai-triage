{
  "name": "@ai-triage/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:documents": "tsx --env-file-if-exists=../../.env src/bin/seed-documents.ts",
    "seed:evals": "tsx --env-file-if-exists=../../.env src/bin/seed-evals.ts",
    "eval:import": "tsx --env-file-if-exists=../../.env src/bin/eval-import.ts",
    "cassettes:record": "tsx --env-file-if-exists=../../.env src/bin/record-cassettes.ts",
    "tenant:delete": "tsx --env-file-if-exists=../../.env src/bin/tenant-delete.ts"
  },
  "dependencies": {
    "@ai-triage/core": "workspace:*",
    "@ai-triage/db": "workspace:*",
    "@ai-triage/evals": "workspace:*",
    "@ai-triage/fixtures": "workspace:*",
    "@ai-triage/ingest": "workspace:*",
    "@ai-triage/llm": "workspace:*",
    "@ai-triage/schemas": "workspace:*",
    "@ai-triage/storage": "workspace:*",
    "pg-boss": "^12.38.0",
    "undici": "^7.30.1"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "tsup": "^9.0.0"
  }
}
